{
  "manifest_version": 3,
  "name": "DDG Alias + KeePassXC",
  "version": "2.0.0",
  "description": "Alias @duck.com i silne hasło jednym kliknięciem, automatyczny zapis loginu i hasła do KeePassXC.",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://quack.duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DDG Alias"
  },
  "key": ""
}